# --- TokenRouter powers the whole voice-agent loop (one key) ---
TOKENROUTER_API_KEY=sk-your-tokenrouter-key
LLM_BASE_URL=https://api.tokenrouter.com/v1

# Providers: set any of these to "mock" to run offline
STT_PROVIDER=hybrid          # mock | browser | hybrid (Web Speech partials + TokenRouter STT refine)
SIGNALS_PROVIDER=jev         # mock | jev | llm
AGENT_PROVIDER=llm           # mock | llm
TTS_PROVIDER=tokenrouter     # mock | tokenrouter

AGENT_MODEL=openai/gpt-4o-mini
SIGNALS_LLM_MODEL=openai/gpt-4o-mini
JEV_MODEL=typesafe/jev-1.14
STT_MODEL=mistralai/voxtral-small-24b-2507
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=shimmer

# Optional: family alert
DISCORD_WEBHOOK_URL=

# Tuning
PII_DELAY_MS=700
PII_UNMUTE_AFTER_S=4
CHALLENGE_MODE=false

# Trusted-person alerts (Telegram): create a bot with @BotFather, paste its token, then have the
# loved one send the bot any message. TELEGRAM_CHAT_ID is discovered automatically if left empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROTECTED_NAME=Grandma
PUBLIC_URL=
